@startuml
'https://plantuml.com/class-diagram
package src {

interface BipartiteGraphInterface {
    + Collection<Vertex> getVertices()
    + int getNumberOfEdges()
    + int getNumberOfVertices()
    + boolean areNeighbors(Vertex u, Vertex v)
    + int getDegree(Vertex u)
    + Collection<Vertex> getNeighborsOf(Vertex u)
    + Map.Entry<Integer,List<Vertex>> runMetaheuristicTest(int maxIterations)
    + Map.Entry<Integer,List<Vertex>> runFirstHeuristic()
    + Map.Entry<Integer,List<Vertex>> runSecondHeuristic()
}

class BipartiteGraph {
}

class Vertex {
    + getIndex()
    + getNeighbors()
}

class Input {
    + textToGraph()
}

BipartiteGraphInterface --> BipartiteGraph

}
@enduml